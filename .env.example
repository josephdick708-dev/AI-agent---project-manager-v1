# Base de données PostgreSQL (Vercel : Neon, Supabase, Vercel Postgres…)
# En production, utilise une URL avec pooler (ex. ?pgbouncer=true ou port 6543)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/peaka?sslmode=require"

# Optionnel : URL directe pour `prisma migrate deploy` (sans pooler)
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/peaka?sslmode=require"

# Auth.js / NextAuth (génère une chaîne longue : openssl rand -base64 32)
AUTH_SECRET=""
# URL publique de l'app (obligatoire en prod sur Vercel)
AUTH_URL="https://ton-app.vercel.app"
# Alias accepté
NEXTAUTH_URL="https://ton-app.vercel.app"

# Google Gemini (AI SDK)
GEMINI_API_KEY=""
# Alias accepté par @ai-sdk/google
# GOOGLE_GENERATIVE_AI_API_KEY=""
# Optionnel (défaut : gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"
